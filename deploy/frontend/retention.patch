diff --git a/src/components/dashboard/RetentionBadge.vue b/src/components/dashboard/RetentionBadge.vue
new file mode 100644
index 0000000..c34bcf8
--- /dev/null
+++ b/src/components/dashboard/RetentionBadge.vue
@@ -0,0 +1,32 @@
+<template>
+    <span class="retention-info" :title="expiryLabel">
+        <el-tag size="small" :type="permanent ? 'info' : expired ? 'danger' : 'warning'">
+            {{ label }}
+        </el-tag>
+        <span v-if="detail && !permanent">{{ expiryLabel }}</span>
+    </span>
+</template>
+
+<script setup>
+import { computed } from 'vue';
+import { useNow } from '@vueuse/core';
+import i18n from '@/locales';
+const props = defineProps({ expiresAt: { type: Number, default: null }, detail: Boolean });
+const t = (key, values) => i18n.global.t(key, values);
+const now = useNow({ interval: 60000 });
+const permanent = computed(() => !Number.isFinite(props.expiresAt));
+const expired = computed(() => !permanent.value && props.expiresAt <= now.value.getTime());
+const expiryLabel = computed(() => permanent.value ? t('retention.permanent') : new Date(props.expiresAt).toLocaleString());
+const label = computed(() => {
+    if (permanent.value) return t('retention.permanent');
+    if (expired.value) return t('retention.expired');
+    const minutes = Math.ceil((props.expiresAt - now.value.getTime()) / 60000);
+    const time = minutes >= 1440 ? t('retention.days', { count: Math.ceil(minutes / 1440) }) :
+        minutes >= 60 ? t('retention.hours', { count: Math.ceil(minutes / 60) }) : t('retention.minutes', { count: minutes });
+    return t('retention.remaining', { time });
+});
+</script>
+
+<style scoped>
+.retention-info { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 6px; font-size: 12px; }
+</style>
